  "vizinhos": "\\b(?:vecin\\w*|parecid\\w*|semejant\\w*|similar(?!idad)\\w*|cercan\\w*|proxim\\w*|cerca de|relacionad\\w*|se parecen a)\\b",
  "similaridade": "\\b(?:son parecid\\w*|se parecen|similaridad|similitud|semejanza|coseno (?:entre|de)|distancia entre|que tan (?:parecid|cercan|similar)\\w*|cuanto se parecen)\\b",
  "direcao": "\\b(?:direccion|producto escalar|producto punto|eje del plural|eje del genero|separar? (?:singular|plural))\\b",
  "conceito": "\\b(?:que (?:es|son|significa|quiere decir)|qu es|explica|explicame|defin\\w*|como funciona\\w*|por que|porque|para que sirve|concepto de)\\b",
  "preset": "\\b(?:ejemplos?|presets?|predefinid\\w*|listos?)\\b",
  "limpar": "\\b(?:limpi\\w*|borr\\w*|quit\\w* todo|elimin\\w* todo|empez\\w* de nuevo|reinici\\w*|resetea\\w*|vaci\\w*)\\b"
 },
