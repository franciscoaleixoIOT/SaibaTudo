# Raiz do repositório único. Cada app tem o próprio .gitignore (segredos, builds, saídas de modelo).
LivrosQuimica/
.kilo/
.idea/
.vercel/
node_modules/
.DS_Store
Thumbs.db
/secrets/
.gradle/
# Benchmark da SaibaTudo IA: saídas brutas e logs ficam fora do Git; o resumo, as tabelas e o painel às cegas podem ser versionados
/tools/benchmark_ia/out/*
!/tools/benchmark_ia/out/resumo.json
!/tools/benchmark_ia/out/tabelas.md
!/tools/benchmark_ia/out/cegas.md
!/tools/benchmark_ia/out/cegas_chave.json
__pycache__/
# SaibaTudo.IA (ia/): venv proprio e saidas grandes (checkpoints, GGUF, logs) ficam fora do Git
/ia/.venv/
/ia/**/out/

# artefatos do navegador de teste (plugin Playwright do Claude Code)
.playwright-mcp/
